[Desktop Entry]
Type=Application
Name=Trackpad gestures
Comment=Three-finger swipe left/right changes browser tab, four-finger swipes toggle fullscreen and change workspace, pinch zooms nsxiv (best-linux-environment)
Exec=sh -c '"$HOME/.local/bin/ble-trackpad-gestures"'
NoDisplay=true
X-GNOME-Autostart-enabled=true
