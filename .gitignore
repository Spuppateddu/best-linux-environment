# OS / editor junk
.DS_Store
*.swp
*.swo
*~

# Backups created by the installer helpers if run in-tree
*.backup.*

# The files you edit. The .example copies beside them are the ones committed.
fonts.local
settings.local
aliases.local

# Your wallpapers: only the README, the b-wallpaper script and default.jpg are tracked.
wallpapers/*
!wallpapers/README.md
!wallpapers/b-wallpaper
!wallpapers/default.jpg

# ./tests/run.sh e2e writes one log per ./setup.sh run here.
tests/e2e/logs/
