#!/usr/bin/env bash
# b-update — update everything on this machine, now: apt (lists, full-upgrade,
# autoremove), then snap and flatpak when they are here. Linked into ~/.local/bin
# by basic/26-update.sh, so zsh and bash both find it on PATH.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: b-update [-y | --count]
  Updates everything, in this order, and stops at the first step that fails:
    1. sudo apt update
    2. sudo apt full-upgrade      (also takes upgrades that need a new package, e.g. a kernel)
    3. sudo apt autoremove --purge
    4. sudo snap refresh          (only if snap is installed)
    5. flatpak update             (only if flatpak is installed)
  -y        answer yes to apt and flatpak instead of asking
  --count   print how many apt updates are waiting, and change nothing
            (the i3 bar and tmux over ssh show it; no root needed)
USAGE
}

# count — the packages `apt full-upgrade` would install or upgrade right now. A
# simulation needs no root and no lock. Cached, because a status bar asks every
# few seconds: rebuilt only when the lists (apt update) or the installed
# packages (an upgrade) are newer than the cache.
count() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/b-update/count"
    local lists="${BLE_APT_LISTS:-/var/lib/apt/lists}" status="${BLE_DPKG_STATUS:-/var/lib/dpkg/status}"
    if [[ -s "$cache" && ! "$lists" -nt "$cache" && ! "$status" -nt "$cache" ]]; then
        cat "$cache"
        return
    fi
    local n
    n="$(apt-get -s -o Debug::NoLocking=1 full-upgrade 2>/dev/null | grep -c '^Inst ')" || true
    mkdir -p "${cache%/*}"
    # Through a temp file: two bars asking at once must never read half a number.
    printf '%s\n' "${n:-0}" > "$cache.$$" && mv -f "$cache.$$" "$cache"
    printf '%s\n' "${n:-0}"
}

YES=()
case "${1:-}" in
    "") ;;
    -y|--yes) YES=(-y) ;;
    --count) count; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

step() { printf '\n\033[1;34m▸ %s\033[0m\n' "$*"; }

step "apt update"
sudo apt update
step "apt full-upgrade"
sudo apt full-upgrade ${YES[@]+"${YES[@]}"}
step "apt autoremove --purge"
sudo apt autoremove --purge ${YES[@]+"${YES[@]}"}

if command -v snap >/dev/null 2>&1; then
    step "snap refresh"
    sudo snap refresh
fi
if command -v flatpak >/dev/null 2>&1; then
    step "flatpak update"
    flatpak update ${YES[@]+"${YES[@]}"}
fi

printf '\n\033[1;32m✓ Everything is up to date.\033[0m\n'
# Written by update-notifier when a new kernel, libc or similar needs a restart.
if [[ -e "${BLE_REBOOT_REQUIRED:-/var/run/reboot-required}" ]]; then
    printf '\033[1;33m! A reboot is needed to finish (a new kernel or core library).\033[0m\n'
fi
